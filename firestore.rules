rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user can read public profile fields (displayName, photoURL)
    // needed for member list in InviteModal. Only the user themselves can write.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // Members can always read their group.
      // Non-members can read a group that has a valid (non-expired) invite code —
      // needed so getGroupByInviteCode can look up the group before joining.
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.memberIds ||
        (resource.data.inviteCode != null &&
         (resource.data.inviteCodeExpiresAt == null ||
          resource.data.inviteCodeExpiresAt > request.time))
      );

      // Owner creates the group
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;

      // Members can update (rename, recolor, remove members, refresh invite code)
      // Non-members can join: they may only add themselves to memberIds + touch updatedAt
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberIds ||
        (
          request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        )
      );

      // Only the owner can delete a group
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

    // Invite code lookup — any signed-in user can read/write so the join flow
    // can do a direct document read instead of a collection query (collection
    // queries with field-dependent rules are rejected by Firestore upfront).
    match /inviteLookup/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Items, shopping, recipes: group members only
    match /items/{itemId} {
      allow read, write: if request.auth != null;
    }

    match /shoppingList/{itemId} {
      allow read, write: if request.auth != null;
    }

    match /recipes/{recipeId} {
      allow read, write: if request.auth != null;
    }

    match /activityLog/{logId} {
      allow read, write: if request.auth != null;
    }
  }
}
