rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // ── Users ─────────────────────────────────────────────────────────────────

    // Any signed-in user can read public profile fields (displayName, photoURL)
    // needed for member list in InviteModal. Only the user themselves can write.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── Groups ────────────────────────────────────────────────────────────────

    match /groups/{groupId} {
      // Members can always read their group.
      // Non-members can read a group that has a valid (non-expired) invite code —
      // needed so getGroupByInviteCode can look up the group before joining.
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        (resource.data.inviteCode != null &&
         (resource.data.inviteCodeExpiresAt == null ||
          resource.data.inviteCodeExpiresAt > request.time))
      );

      // Owner creates the group
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId;

      // Members can update (rename, recolor, remove members, refresh invite code).
      // Non-members can join: may only append themselves to memberIds + touch updatedAt.
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        (
          request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        )
      );

      // Only the owner can delete a group
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.ownerId;
    }

    // ── Invite lookup ─────────────────────────────────────────────────────────

    // Any signed-in user can read/write so the join flow can do a direct
    // document read instead of a collection query (queries with field-dependent
    // rules are rejected by Firestore upfront).
    match /inviteLookup/{code} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── Items ─────────────────────────────────────────────────────────────────

    match /items/{itemId} {
      allow read, delete: if isGroupMember(resource.data.groupId);
      allow create, update: if isGroupMember(request.resource.data.groupId);
    }

    // ── Shopping list ─────────────────────────────────────────────────────────

    match /shoppingList/{itemId} {
      allow read, delete: if isGroupMember(resource.data.groupId);
      allow create, update: if isGroupMember(request.resource.data.groupId);
    }

    // ── Recipes ───────────────────────────────────────────────────────────────

    match /recipes/{recipeId} {
      allow read, delete: if isGroupMember(resource.data.groupId);
      allow create, update: if isGroupMember(request.resource.data.groupId);
    }

    // ── Activity log ──────────────────────────────────────────────────────────

    // Append-only: members can read and create, but not edit or delete entries.
    match /activityLog/{logId} {
      allow read, create: if isGroupMember(resource.data.groupId);
      allow update, delete: if false;
    }
  }
}
